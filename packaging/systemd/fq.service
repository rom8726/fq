[Unit]
Description=fq quota database
Documentation=https://github.com/fq-db/fq
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fq
Group=fq
ExecStart=/usr/bin/fq /etc/fq/config.yml
Restart=on-failure
RestartSec=5s
WorkingDirectory=/var/lib/fq
RuntimeDirectory=fq
RuntimeDirectoryMode=0750
StateDirectory=fq
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/fq

[Install]
WantedBy=multi-user.target
